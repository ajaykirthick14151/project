
students = {}

subjects = ["Tamil", "English", "Maths", "Science", "Computer"]


def add_student():
    reg_no = input("Enter register number: ")

    if reg_no in students:
        print("Student already exists!")
        return

    name = input("Enter student name: ")
    marks = []

    for subject in subjects:
        mark = int(input("Enter marks in " + subject + ": "))
        marks.append(mark)

    students[reg_no] = {
        "name": name,
        "marks": marks
    }

    print("Student added successfully!")


def search_student():
    reg_no = input("Enter register number to search: ")

    if reg_no in students:
        print("\nStudent Name:", students[reg_no]["name"])
        print("Register Number:", reg_no)
        print("Marks:", students[reg_no]["marks"])
    else:
        print("Student not found!")


def update_marks():
    reg_no = input("Enter register number: ")

    if reg_no in students:
        marks = []

        for subject in subjects:
            mark = int(input("Enter new marks in " + subject + ": "))
            marks.append(mark)

        students[reg_no]["marks"] = marks
        print("Marks updated successfully!")
    else:
        print("Student not found!")


def delete_student():
    reg_no = input("Enter register number to delete: ")

    if reg_no in students:
        del students[reg_no]
        print("Student deleted successfully!")
    else:
        print("Student not found!")


def display_students():
    if not students:
        print("No student records available.")
        return

    for reg_no, details in students.items():
        print("\n----------------------")
        print("Name:", details["name"])
        print("Register Number:", reg_no)

        for i in range(len(subjects)):
            print(subjects[i] + ":", details["marks"][i])

        print("Total Marks:", sum(details["marks"]))


def main():
    while True:
        print("\n===== STUDENT RECORD MANAGEMENT =====")
        print("1. Add Student")
        print("2. Search Student")
        print("3. Update Marks")
        print("4. Delete Student")
        print("5. Display All Students")
        print("6. Exit")

        choice = input("Enter your choice: ")

        if choice == "1":
            add_student()
        elif choice == "2":
            search_student()
        elif choice == "3":
            update_marks()
        elif choice == "4":
            delete_student()
        elif choice == "5":
            display_students()
        elif choice == "6":
            print("Exiting the system...")
            break
        else:
            print("Invalid choice! Try again.")


main()
